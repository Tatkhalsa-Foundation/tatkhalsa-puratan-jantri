# Tat Khalsa Puratan Jantri — Environment Variables
# This application is a static, client-side Progressive Web App (PWA) with zero
# server-side secrets or private API keys required at runtime or build time.
#
# Optional public Google Identity Services OAuth Client ID (browser-only, NO client_secret):
# When left blank, the "Sync via Google Account" button gracefully displays a coming-soon notice
# and users can subscribe via 1-Click Google Calendar Subscribe or Apple Calendar webcal://.
VITE_GOOGLE_CLIENT_ID=

# Optional dev flag:
# DISABLE_HMR=false
